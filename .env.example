# Copy this file to .env and fill in whichever key you have. One is enough.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a key.
#
# The chain is tried in this order and falls back to the deterministic baseline
# classifier when every provider is missing, rate-limited or failing, so the demo
# runs offline with this file empty.
#
# Free tiers, no card required:
#   Gemini   https://aistudio.google.com/apikey
#   Mistral  https://console.mistral.ai/api-keys
#   Groq     https://console.groq.com/keys

GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Optional. The model each provider is asked for, if you want something other than
# the free-tier default in sesn/providers.py (gemini-2.0-flash, ministral-8b-latest,
# llama-3.3-70b-versatile). The control panel shows whichever is live.
# GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_MODEL=mistral-small-latest   # better, but 429s on a new free key
# GROQ_MODEL=llama-3.3-70b-versatile
